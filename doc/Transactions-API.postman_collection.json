{
	"info": {
		"_postman_id": "transactions-api-collection",
		"name": "Transactions API",
		"description": "API collection for the Transactions controller: create draft transactions, add items, submit, and cancel.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "transaction_url",
			"value": "http://localhost:5000"
		},
		{
			"key": "transactionId",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Create Transaction",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"currency\": \"USD\"\n}"
				},
				"url": {
					"raw": "{{transaction_url}}/api/transactions",
					"host": ["{{transaction_url}}"],
					"path": ["api", "transactions"]
				},
				"description": "Create a new transaction (Draft). Returns created transaction (e.g. id) on success."
			}
		},
		{
			"name": "Add Transaction Items",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"transactionId\": \"{{transactionId}}\",\n  \"items\": [\n    {\n      \"description\": \"Product A\",\n      \"quantity\": 2,\n      \"unitPrice\": 29.99\n    },\n    {\n      \"description\": \"Product B\",\n      \"quantity\": 1,\n      \"unitPrice\": 99.50\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{transaction_url}}/api/transactions/{{transactionId}}/items",
					"host": ["{{transaction_url}}"],
					"path": ["api", "transactions", "{{transactionId}}", "items"]
				},
				"description": "Add items to a draft transaction. Use the transaction id from Create Transaction (set {{transactionId}} or paste in path and body)."
			}
		},
		{
			"name": "Submit Transaction",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{transaction_url}}/api/transactions/{{transactionId}}/submit",
					"host": ["{{transaction_url}}"],
					"path": ["api", "transactions", "{{transactionId}}", "submit"]
				},
				"description": "Submit transaction. Publishes TransactionSubmitted event. Returns 204 No Content on success."
			}
		},
		{
			"name": "Cancel Transaction",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{transaction_url}}/api/transactions/{{transactionId}}/cancel",
					"host": ["{{transaction_url}}"],
					"path": ["api", "transactions", "{{transactionId}}", "cancel"]
				},
				"description": "Cancel a draft or submitted transaction. Returns 204 No Content on success."
			}
		}
	]
}
